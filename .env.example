# ---------- App ----------
APP_NAME=Complify Chat API
ENVIRONMENT=dev
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ---------- Database (SQLite file outside app/) ----------
DATABASE_URL=sqlite:///./data/complify.db

# ---------- Storage ----------
# local = files on disk under LOCAL_STORAGE_DIR (current setup)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
STANDARDS_PREFIX=standards/
REPORTS_PREFIX=reports/

# S3 (later): set STORAGE_BACKEND=s3 and fill these. Same folder layout is used as S3 keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
S3_ENDPOINT_URL=

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
# check the models available on your account
OPENAI_MODEL=gpt-6-astra
OPENAI_TIMEOUT_SECONDS=300
OPENAI_MAX_OUTPUT_TOKENS=8000
# structured evaluation (Excel/PDF report) is large
EVAL_MAX_OUTPUT_TOKENS=32000

# ---------- Evaluation PDF branding (your own format) ----------
BRAND_NAME=Complify
BRAND_TAGLINE=Compliance Engineering & Technical Evaluation
BRAND_COLOR=#086457
# optional logo on the cover (PNG/JPG path)
BRAND_LOGO_PATH=
EVALUATION_PREPARED_BY=Complify Evaluation Engine

# ---------- Upload limits ----------
MAX_UPLOAD_MB=50
MAX_STANDARDS_PER_REQUEST=2
# Part 2 automatically brings its Part 1 parent, so context can hold one more
MAX_STANDARDS_IN_CONTEXT=3

# ---------- Rate limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ---------- Response cache ----------
CACHE_ENABLED=true
# 1.0 = exact (normalised) prompt match. 0.95 = fuzzy, but risky:
# "clause 10.1" and "clause 10.2" would count as the same prompt.
CACHE_SIMILARITY_THRESHOLD=1.0
