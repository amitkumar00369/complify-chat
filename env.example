# =====================================================================
# Complify Chat API - environment template
# Copy to .env and fill the values:   copy .env.example .env   (Windows)
# Never commit .env (it is in .gitignore).
# =====================================================================

# ---------- App ----------
APP_NAME=Complify Chat API
ENVIRONMENT=dev
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ---------- Database ----------
# PostgreSQL (production):
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# SQLite (local dev):
# DATABASE_URL=sqlite+aiosqlite:///./data/complify.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------- Storage ----------
# s3    = AWS S3 (production)
# local = files on disk under LOCAL_STORAGE_DIR
STORAGE_BACKEND=s3
LOCAL_STORAGE_DIR=./storage
STANDARDS_PREFIX=standards/
REPORTS_PREFIX=reports/

# S3 (same folder layout is used as S3 keys: standards/..., reports/{id}/...)
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1
S3_BUCKET=your-bucket-name
# only for MinIO / LocalStack; leave empty for AWS
S3_ENDPOINT_URL=

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
# check the models available on your account
OPENAI_MODEL=gpt-6-astra
OPENAI_TIMEOUT_SECONDS=300
OPENAI_MAX_OUTPUT_TOKENS=8000
# structured evaluation (Excel/PDF report) is large
EVAL_MAX_OUTPUT_TOKENS=32000

# ---------- Evaluation PDF branding (your own format) ----------
BRAND_NAME=Complify
BRAND_TAGLINE=Compliance Engineering & Technical Evaluation
BRAND_COLOR=#086457
# optional logo on the PDF cover (PNG/JPG path)
BRAND_LOGO_PATH=
EVALUATION_PREPARED_BY=Complify Evaluation Engine

# ---------- Upload limits ----------
MAX_UPLOAD_MB=50
MAX_STANDARDS_PER_REQUEST=2
# Part 2 automatically brings its Part 1 parent, so context can hold one more
MAX_STANDARDS_IN_CONTEXT=3

# ---------- Rate limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ---------- Response cache ----------
CACHE_ENABLED=true
# 1.0 = exact (normalised) prompt match. 0.95 = fuzzy, but risky:
# "clause 10.1" and "clause 10.2" would count as the same prompt.
CACHE_SIMILARITY_THRESHOLD=1.0

# ---------- Chat -> Excel/PDF ----------
# evaluation answer in /chat -> Excel + PDF in the same response (no extra AI call)
AUTO_EXPORT_CHAT_EVALUATION=true
# same report uploaded again -> stored evaluation returned (no AI call)
REUSE_REPORT_OUTPUT=true
